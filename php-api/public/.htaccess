# NowPetMe on Apache (HostGator). Deployed next to the built React app (index.html + assets/).
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS (HostGator provides a free SSL certificate in cPanel -> SSL/TLS Status).
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# API: everything under /api goes through the PHP front controller.
RewriteRule ^api/index\.php$ - [L]
RewriteRule ^api(/.*)?$ api/index.php [L,QSA]

# Pet pages get server-rendered share tags (title, description, image) so links preview nicely.
RewriteRule ^pet/([0-9]+)/?$ seo.php?id=$1 [L,QSA]

# Everything else that is not a real file is the React app (client-side routing).
RewriteCond %{REQUEST_URI} !^/uploads/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Vite builds hashed file names, so assets can be cached for a year.
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Never serve internal PHP files directly (only api/index.php and seo.php are entry points).
<FilesMatch "^\.ht">
  Require all denied
</FilesMatch>
